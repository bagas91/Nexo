##############################
# Backend (.env example)
##############################

# --- Segurança (produção) ---
# Se definido, todas as rotas /api (exceto status, health, login, qr) exigem header X-API-Key ou Authorization: Bearer <valor>
# API_KEY=

# --- Evolution API (opcional; se não usar, pode ignorar) ---
# EVOLUTION_API_URL=http://localhost:8080
# EVOLUTION_API_KEY=change-me-to-your-global-api-key
# EVOLUTION_INSTANCE_NAME=zapflow_saas

# --- Alertas (Discord / WhatsApp) ---
# URL do webhook do Discord para receber alertas de erro/falha.
# Obrigatório em produção para receber avisos (auth_failure, disco cheio, envio falho, etc.).
# Para obter: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
#
# Se =1, também envia para o Discord TODAS as linhas [WARN] do logger (pode ser frequente; use canal dedicado)
# DISCORD_LOG_WARN=0

# Número WhatsApp que receberá alertas (formato internacional, só dígitos). Opcional.
# Exemplo: 5511999999999
# ALERT_WHATSAPP_NUMBER=

# Relatório automático ao fim de cada disparo (Discord e/ou WhatsApp).
# Por padrão ligado se DISCORD_WEBHOOK_URL ou ALERT_WHATSAPP_NUMBER estiver definido.
# NOTIFY_BULK_REPORT=1
#
# Número WhatsApp só para relatórios de disparo (opcional; se omitido, usa ALERT_WHATSAPP_NUMBER).
# BULK_REPORT_WHATSAPP_NUMBER=5511999999999

# --- Tempo (opcional) ---
# Tempo máximo em ms para aguardar o cliente WhatsApp ficar pronto após reconexão (default: 120000 = 2 min)
# WAIT_FOR_READY_MS=120000

# --- Reinicialização controlada (produção) ---
# Horário diário para restart preventivo do cliente WhatsApp (formato HH:mm)
# Exemplo: 03:30
# DAILY_RESTART_TIME=03:30
#
# Timezone para o horário acima
# Exemplo: America/Sao_Paulo
# DAILY_RESTART_TZ=America/Sao_Paulo
#
# Se houver envio/worker ativo no momento do restart, adia em X ms e tenta novamente
# RESTART_SAFE_DELAY_MS=120000
#
# Timeout máximo para concluir restart controlado (backup + destroy + initialize)
# RESTART_TIMEOUT_MS=120000
#
# Healthcheck: intervalo entre verificações de travamento (ms)
# HEALTHCHECK_INTERVAL_MS=60000
#
# Healthcheck: se sem atividade por mais que isso (ms), considera possível travamento
# HEALTHCHECK_STALE_MS=900000
#
# Healthcheck: cooldown entre restarts automáticos por saúde (ms)
# HEALTHCHECK_RESTART_COOLDOWN_MS=1800000
#
# Healthcheck: se nunca ficou “ready” (UI presa em sincronizar) e sem QR há mais que isto (ms), força restart controlado (default código 720000 = 12 min; VPS lenta: 3600000)
# HEALTHCHECK_STUCK_CONNECTING_MS=720000
#
# Tentativas de whatsappClient.initialize() ao subir o servidor (rede lenta ou lock após reboot)
# STARTUP_INIT_MAX_ATTEMPTS=6
# STARTUP_INIT_RETRY_MS=8000

# --- Retenção de backup de sessão ---
# Mantém somente os backups dos últimos N dias (aplica em backup e backup_archive).
# Recomendado para evitar encher disco em produção.
# BACKUP_RETENTION_DAYS=3

# NOTIFY_SYSTEM_NAME=Nexo Dev
# BRAND_PRODUCT_NAME=Nexo
# BRAND_TENANT_NAME=Cristian Dev
# BRAND_STORE_URL=https://exemplo.com
# BRAND_CATALOG_BRAND=Virginia Arruda
# BRAND_VPS_URL=https://cristian.vps-kinghost.net
# ADMIN_PASS=
# ADMIN_NAME=Administrador
# AUTH_SECRET=              # Segredo para tokens de sessão (produção)

# --- Assistente de IA (geração de legendas no painel) ---
# Pelo menos uma chave é necessária. Chaves ficam só no servidor (não vão pro navegador).
# GEMINI_API_KEY=           # Google AI Studio — https://aistudio.google.com/apikey
# OPENAI_API_KEY=           # OpenAI — https://platform.openai.com/api-keys
# AI_DEFAULT_PROVIDER=gemini
# AI_GEMINI_MODEL=gemini-2.0-flash
# AI_OPENAI_MODEL=gpt-4o-mini

# --- Palavra do Dia (template fixo + links padrão) ---
# PDD_LINK_PALAVRA=https://youtu.be/fAY3SsWO394
# PDD_LINK_MINISTERIO=https://youtu.be/HplnvYBErP8
# PDD_LINK_VIRGINIA=   # legado; use PDD_LINK_MINISTERIO
# PDD_LINK_MUSICA=https://youtu.be/example
# PDD_LINK_CULTO=https://www.youtube.com/live/...
# PDD_CULTO_TEXTO=Quinta-feira, 02 de julho de 2026.
# BIBLE_TRANSLATION=ARA

