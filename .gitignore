# Dependencies
node_modules/
server/node_modules/

# Build
dist/
dist-ssr/

# Environment & secrets (nunca commitar)
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# WhatsApp session (Chrome profile — ~2GB, dados sensíveis)
server/.wwebjs_auth/
server/.wwebjs_cache/

# SQLite / dados locais
*.db
*.sqlite
server/uploads/
server/logs/
server/data/
server/media/
server/inbox-media/
server/inbox-avatars/

# Exports / inventários locais (não versionar)
inventario-*.csv
*.csv

# PM2 / runtime
.pm2/
pids/
*.pid

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Pastas duplicadas por upload acidental
server/services/services/
server/utils/utils/

# Local overrides
*.local
<!DOCTYPE html>.js
